ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/cozy_bookmarks.db

AI_TAGGING_ENABLED=true
AI_TIMEOUT_SECONDS=30

# "claude" for the native Anthropic adapter; anything else (default) uses the
# OpenAI-compatible slot below - point it at your homelab LLM, Qwen
# (DashScope compatible-mode or self-hosted), OpenAI itself, or any other
# /chat/completions-shaped service.
AI_PROVIDER=openai_compatible
AI_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
AI_OPENAI_COMPATIBLE_MODEL=default
AI_OPENAI_COMPATIBLE_API_KEY=

AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=claude-opus-5

# Daily Digest / Email configuration
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Cozy Bookmarks <noreply@example.com>"
SMTP_TLS=true
SMTP_SSL=false
BASE_URL=http://bookmarks.example.com
